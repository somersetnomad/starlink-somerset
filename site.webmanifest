---
layout: null
permalink: /site.webmanifest
sitemap: false
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "start_url": {{ '/' | relative_url | jsonify }},
  "display": "standalone",
  "background_color": "#fcfcfb",
  "theme_color": "#2f6f5e",
  "icons": [
    { "src": {{ '/assets/icons/icon-192.png' | relative_url | jsonify }}, "sizes": "192x192", "type": "image/png" },
    { "src": {{ '/assets/icons/icon-512.png' | relative_url | jsonify }}, "sizes": "512x512", "type": "image/png" }
  ]
}
